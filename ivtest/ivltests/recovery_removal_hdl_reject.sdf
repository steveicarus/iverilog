(DELAYFILE (SDFVERSION "3.0") (DIVIDER /) (TIMESCALE 1ps)
 (CELL (CELLTYPE "rr_reject") (INSTANCE wrong_control) (TIMINGCHECK (RECOVERY (posedge OTHER) (posedge C) (30:30:30)) (REMOVAL (posedge OTHER) (posedge C) (30:30:30))))
 (CELL (CELLTYPE "rr_reject") (INSTANCE wrong_clock) (TIMINGCHECK (RECOVERY (posedge R) (posedge OTHER) (30:30:30)) (REMOVAL (posedge R) (posedge OTHER) (30:30:30))))
 (CELL (CELLTYPE "rr_reject") (INSTANCE wrong_edge) (TIMINGCHECK (RECOVERY (negedge R) (posedge C) (30:30:30)) (REMOVAL (negedge R) (posedge C) (30:30:30))))
 (CELL (CELLTYPE "rr_reject") (INSTANCE negative) (TIMINGCHECK (RECOVERY (posedge R) (posedge C) (-4096:-4096:-4096)) (REMOVAL (posedge R) (posedge C) (-4096:-4096:-4096))))
 (CELL (CELLTYPE "rr_reject") (INSTANCE overflow) (TIMINGCHECK (RECOVERY (posedge R) (posedge C) (1e30:1e30:1e30)) (REMOVAL (posedge R) (posedge C) (1e30:1e30:1e30))))
 (CELL (CELLTYPE "different_cell") (INSTANCE wrong_cell) (TIMINGCHECK (RECOVERY (posedge R) (posedge C) (30:30:30)) (REMOVAL (posedge R) (posedge C) (30:30:30))))
 (CELL (CELLTYPE "rr_reject") (INSTANCE conditional) (TIMINGCHECK (RECOVERY (COND OTHER (posedge R)) (posedge C) (30:30:30)) (REMOVAL (COND OTHER (posedge R)) (posedge C) (30:30:30))))
 (CELL (CELLTYPE "rr_reject") (INSTANCE hierarchy) (TIMINGCHECK (RECOVERY nested/R (posedge C) (30:30:30)) (REMOVAL nested/R (posedge C) (30:30:30))))
 (CELL (CELLTYPE "rr_reject") (INSTANCE valid) (TIMINGCHECK (RECOVERY (posedge R) (posedge C) (30:30:30)) (REMOVAL (posedge R) (posedge C) (30:30:30))))
 (CELL (CELLTYPE "rr_reject") (INSTANCE absent_instance) (TIMINGCHECK (RECOVERY (posedge R) (posedge C) (50:50:50)) (REMOVAL (posedge R) (posedge C) (50:50:50))))
 (CELL (CELLTYPE "rr_reject") (INSTANCE combined) (TIMINGCHECK (RECREM (posedge R) (posedge C) (30:30:30) (30:30:30))))
)
