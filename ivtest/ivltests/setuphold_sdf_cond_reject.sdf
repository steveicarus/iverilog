(DELAYFILE (SDFVERSION "3.0") (DIVIDER /) (TIMESCALE 1ps)
 (CELL (CELLTYPE "setuphold_cond_reject") (INSTANCE u) (TIMINGCHECK
  (SETUPHOLD (COND F === 1'b0 D) (COND E == 1'b1 (posedge C)) (99:99:99) (99:99:99))
  (SETUPHOLD (COND F === 1'b0 D) (COND E != 1'b1 (posedge C)) (99:99:99) (99:99:99))
  (SETUPHOLD (COND F === 1'b0 D) (COND !E (posedge C)) (99:99:99) (99:99:99))
  (SETUPHOLD (COND F === 1'b0 D) (COND E[0] (posedge C)) (99:99:99) (99:99:99))
  (SETUPHOLD (COND F === 1'b0 D) (COND sub/E (posedge C)) (99:99:99) (99:99:99))
  (SETUPHOLD (COND F === 1'b0 D) (COND G (posedge C)) (99:99:99) (99:99:99))
  (SETUPHOLD (COND F === 1'b0 D) (COND E === 1'b1 (posedge C)) (99:99:99) (99:99:99))
  (SETUPHOLD (COND F === 1'b0 D) (COND E === 1'b0 (posedge C)) (99:99:99) (99:99:99))
  (SETUPHOLD (COND F === 1'b0 D) (COND E (negedge C)) (99:99:99) (99:99:99))
  (SETUPHOLD (COND F == 1'b1 D) (COND E (posedge C)) (99:99:99) (99:99:99))
  (SETUPHOLD (COND F != 1'b1 D) (COND E (posedge C)) (99:99:99) (99:99:99))
  (SETUPHOLD (COND !F D) (COND E (posedge C)) (99:99:99) (99:99:99))
  (SETUPHOLD (COND F[0] D) (COND E (posedge C)) (99:99:99) (99:99:99))
  (SETUPHOLD (COND sub/F D) (COND E (posedge C)) (99:99:99) (99:99:99))
  (SETUPHOLD (COND G D) (COND E (posedge C)) (99:99:99) (99:99:99))
  (SETUPHOLD (COND F D) (COND E (posedge C)) (99:99:99) (99:99:99))
  (SETUPHOLD (COND F === 1'b1 D) (COND E (posedge C)) (99:99:99) (99:99:99))
  (SETUPHOLD (COND F === 1'b0 (negedge D)) (COND E (posedge C)) (99:99:99) (99:99:99))))
 (CELL (CELLTYPE "setuphold_cond_reject") (INSTANCE neg_second) (TIMINGCHECK (SETUPHOLD (COND F === 1'b0 D) (COND E (posedge C)) (99:99:99) (-1:-1:-1))))
 (CELL (CELLTYPE "setuphold_cond_reject") (INSTANCE neg_first) (TIMINGCHECK (SETUPHOLD (COND F === 1'b0 D) (COND E (posedge C)) (-1:-1:-1) (99:99:99))))
 (CELL (CELLTYPE "setuphold_cond_reject") (INSTANCE u) (TIMINGCHECK (SETUPHOLD (COND F === 1'b0 D) (COND E (posedge C)) (1.0e30) (-1))))
 (CELL (CELLTYPE "setuphold_cond_reject") (INSTANCE u) (TIMINGCHECK (SETUPHOLD (COND F === 1'b0 D) (COND E (posedge C)) (-1) (1.0e30))))
 (CELL (CELLTYPE "setuphold_cond_reject") (INSTANCE valid) (TIMINGCHECK
