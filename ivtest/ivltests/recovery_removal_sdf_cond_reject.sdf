(DELAYFILE (SDFVERSION "3.0") (DIVIDER /) (TIMESCALE 1ps)
 (CELL (CELLTYPE "dut") (INSTANCE u) (TIMINGCHECK
  (RECOVERY (COND E == 1'b1 R) (posedge C) (30:30:30))
  (REMOVAL (COND E == 1'b1 R) (posedge C) (30:30:30))
  (RECOVERY (COND E != 1'b0 R) (posedge C) (30:30:30))
  (REMOVAL (COND E != 1'b0 R) (posedge C) (30:30:30))
  (RECOVERY (COND E !== 1'b0 R) (posedge C) (30:30:30))
  (REMOVAL (COND E !== 1'b0 R) (posedge C) (30:30:30))
  (RECOVERY (COND ~E R) (posedge C) (30:30:30))
  (REMOVAL (COND ~E R) (posedge C) (30:30:30))
  (RECOVERY (COND !E R) (posedge C) (30:30:30))
  (REMOVAL (COND !E R) (posedge C) (30:30:30))
  (RECOVERY (COND E[0] R) (posedge C) (30:30:30))
  (REMOVAL (COND E[0] R) (posedge C) (30:30:30))
  (RECOVERY (COND sub/E R) (posedge C) (30:30:30))
  (REMOVAL (COND sub/E R) (posedge C) (30:30:30))
  (RECOVERY (COND F R) (posedge C) (30:30:30))
  (REMOVAL (COND F R) (posedge C) (30:30:30))
  (RECOVERY (COND E === 1'b1 R) (posedge C) (30:30:30))
  (REMOVAL (COND E === 1'b1 R) (posedge C) (30:30:30))
  (RECOVERY (COND E === 1'b0 R) (posedge C) (30:30:30))
  (REMOVAL (COND E === 1'b0 R) (posedge C) (30:30:30))
  (RECOVERY (COND E R) (COND F === 1'b1 (posedge C)) (30:30:30))
  (RECOVERY (COND E R) (COND F === 1'b0 (negedge C)) (30:30:30))
  (REMOVAL (COND E R) (COND F === 1'b1 (posedge C)) (30:30:30))
  (REMOVAL (COND E R) (COND F === 1'b0 (negedge C)) (30:30:30))))
 (CELL (CELLTYPE "dut") (INSTANCE valid) (TIMINGCHECK
  (RECOVERY (COND E R) (COND F === 1'b0 (posedge C)) (20:20:20))
  (REMOVAL (COND E R) (COND F === 1'b0 (posedge C)) (20:20:20))))
)
