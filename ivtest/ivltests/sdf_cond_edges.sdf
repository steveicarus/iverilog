  (DELAY (ABSOLUTE
   (COND E (IOPATH (posedge A) Z (3) (13)))
   (COND E (IOPATH (negedge A) Z (17) (5))))))
 (CELL (CELLTYPE "ordinary_cell") (INSTANCE ordinary_u)
  (DELAY (ABSOLUTE (IOPATH A Z (7) (9)))))
 (CELL (CELLTYPE "legacy_conditional_cell") (INSTANCE legacy_u)
