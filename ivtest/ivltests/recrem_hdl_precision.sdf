(DELAYFILE (SDFVERSION "3.0") (TIMESCALE 1ps)
 (CELL (CELLTYPE "rrc_precision") (INSTANCE recovery_only)
  (TIMINGCHECK (RECOVERY (posedge R) (posedge C) (17:17:17))))
 (CELL (CELLTYPE "rrc_precision") (INSTANCE removal_only)
  (TIMINGCHECK (REMOVAL (posedge R) (posedge C) (19:19:19))))
 (CELL (CELLTYPE "rrc_precision") (INSTANCE omitted_recovery)
  (TIMINGCHECK (RECREM (posedge R) (posedge C) () (23:23:23))))
 (CELL (CELLTYPE "rrc_precision") (INSTANCE omitted_removal)
  (TIMINGCHECK (RECREM (posedge R) (posedge C) (29:29:29) ())))
)
