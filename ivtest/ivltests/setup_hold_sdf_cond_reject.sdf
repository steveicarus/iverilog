(DELAYFILE (SDFVERSION "3.0") (DIVIDER /) (TIMESCALE 1ps)
 (CELL (CELLTYPE "dut") (INSTANCE u) (TIMINGCHECK
  (SETUP (COND E == 1'b1 D) (posedge C) (30:30:30))
  (HOLD (COND E == 1'b1 D) (posedge C) (30:30:30))
  (SETUP (COND E != 1'b0 D) (posedge C) (30:30:30))
  (HOLD (COND E != 1'b0 D) (posedge C) (30:30:30))
  (SETUP (COND E !== 1'b0 D) (posedge C) (30:30:30))
  (HOLD (COND E !== 1'b0 D) (posedge C) (30:30:30))
  (SETUP (COND ~E D) (posedge C) (30:30:30))
  (HOLD (COND ~E D) (posedge C) (30:30:30))
  (SETUP (COND !E D) (posedge C) (30:30:30))
  (HOLD (COND !E D) (posedge C) (30:30:30))
  (SETUP (COND E[0] D) (posedge C) (30:30:30))
  (HOLD (COND E[0] D) (posedge C) (30:30:30))
  (SETUP (COND sub/E D) (posedge C) (30:30:30))
  (HOLD (COND sub/E D) (posedge C) (30:30:30))
  (SETUP (COND F D) (posedge C) (30:30:30))
  (HOLD (COND F D) (posedge C) (30:30:30))
  (SETUP (COND E === 1'b1 D) (posedge C) (30:30:30))
  (HOLD (COND E === 1'b1 D) (posedge C) (30:30:30))
  (SETUP (COND E === 1'b0 D) (posedge C) (30:30:30))
  (HOLD (COND E === 1'b0 D) (posedge C) (30:30:30))
  (SETUP (COND E D) (COND F === 1'b1 (posedge C)) (30:30:30))
  (SETUP (COND E D) (COND F === 1'b0 (negedge C)) (30:30:30))
  (HOLD (COND E D) (COND F === 1'b1 (posedge C)) (30:30:30))
  (HOLD (COND E D) (COND F === 1'b0 (negedge C)) (30:30:30))))
 (CELL (CELLTYPE "dut") (INSTANCE valid) (TIMINGCHECK
  (SETUP (COND E D) (COND F === 1'b0 (posedge C)) (20:20:20))
  (HOLD (COND E D) (COND F === 1'b0 (posedge C)) (20:20:20))))
)
