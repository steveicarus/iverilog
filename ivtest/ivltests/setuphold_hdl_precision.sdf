(DELAYFILE (SDFVERSION "3.0") (TIMESCALE 1ps)
 (CELL (CELLTYPE "shc_precision") (INSTANCE setup_only)
  (TIMINGCHECK (SETUP (posedge D) (posedge C) (17:17:17))))
 (CELL (CELLTYPE "shc_precision") (INSTANCE hold_only)
  (TIMINGCHECK (HOLD (posedge D) (posedge C) (19:19:19))))
 (CELL (CELLTYPE "shc_precision") (INSTANCE omitted_setup)
  (TIMINGCHECK (SETUPHOLD (posedge D) (posedge C) () (23:23:23))))
 (CELL (CELLTYPE "shc_precision") (INSTANCE omitted_hold)
  (TIMINGCHECK (SETUPHOLD (posedge D) (posedge C) (29:29:29) ())))
)
