   (COND E\=\=1\'b1 (IOPATH A ZH (27) (29)))
   (COND gate\"quote == 1'b1 (IOPATH A ZQ (31) (33)))
   (COND gate\\back == 1'b1 (IOPATH A ZK (35) (37)))
   (IOPATH A ZU (39) (41))
   (COND (E == 1'b1 && (F == 1'b0 && G == 1'b1)) (IOPATH A ZL (91) (93)))
   (COND ((F == 1'b0 && E == 1'b1) && G == 1'b1) (IOPATH A ZL (91) (93)))
