(DELAYFILE (SDFVERSION "3.0") (TIMESCALE 1ps)
 (CELL (CELLTYPE "rrc_map") (INSTANCE combined) (TIMINGCHECK (RECREM D (posedge C) (20:20:20) (8:8:8))))
 (CELL (CELLTYPE "rrc_map") (INSTANCE partial_recovery) (TIMINGCHECK (RECREM D (posedge C) (20:20:20) (8:8:8)) (RECOVERY D (posedge C) (7:7:7))))
 (CELL (CELLTYPE "rrc_map") (INSTANCE partial_removal) (TIMINGCHECK (RECREM D (posedge C) (20:20:20) (8:8:8)) (REMOVAL D (posedge C) (3:3:3))))
 (CELL (CELLTYPE "rrc_map") (INSTANCE separate) (TIMINGCHECK (RECOVERY D (posedge C) (20:20:20)) (REMOVAL D (posedge C) (8:8:8))))
 (CELL (CELLTYPE "rrc_map") (INSTANCE wrong_edge) (TIMINGCHECK (RECREM D (negedge C) (20:20:20) (8:8:8))))
 (CELL (CELLTYPE "rrc_map") (INSTANCE wrong_data) (TIMINGCHECK (RECREM E (posedge C) (20:20:20) (8:8:8))))
 (CELL (CELLTYPE "rrc_map") (INSTANCE empty_recovery) (TIMINGCHECK (RECREM D (posedge C) () (8:8:8))))
 (CELL (CELLTYPE "rrc_map") (INSTANCE empty_removal) (TIMINGCHECK (RECREM D (posedge C) (20:20:20) ())))
)
