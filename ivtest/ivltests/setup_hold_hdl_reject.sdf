(DELAYFILE (SDFVERSION "3.0") (DIVIDER /) (TIMESCALE 1ps)
 (CELL (CELLTYPE "sh_reject") (INSTANCE wrong_data) (TIMINGCHECK (SETUP OTHER (posedge C) (30:30:30)) (HOLD OTHER (posedge C) (30:30:30))))
 (CELL (CELLTYPE "sh_reject") (INSTANCE wrong_ref) (TIMINGCHECK (SETUP D (posedge OTHER) (30:30:30)) (HOLD D (posedge OTHER) (30:30:30))))
 (CELL (CELLTYPE "sh_reject") (INSTANCE wrong_edge) (TIMINGCHECK (SETUP D (negedge C) (30:30:30)) (HOLD D (negedge C) (30:30:30))))
 (CELL (CELLTYPE "sh_reject") (INSTANCE negative) (TIMINGCHECK (SETUP D (posedge C) (-4096:-4096:-4096)) (HOLD D (posedge C) (-4096:-4096:-4096))))
 (CELL (CELLTYPE "sh_reject") (INSTANCE overflow) (TIMINGCHECK (SETUP D (posedge C) (1e30:1e30:1e30)) (HOLD D (posedge C) (1e30:1e30:1e30))))
 (CELL (CELLTYPE "different_cell") (INSTANCE wrong_cell) (TIMINGCHECK (SETUP D (posedge C) (30:30:30)) (HOLD D (posedge C) (30:30:30))))
 (CELL (CELLTYPE "sh_reject") (INSTANCE conditional) (TIMINGCHECK (SETUP (COND OTHER D) (posedge C) (30:30:30)) (HOLD (COND OTHER D) (posedge C) (30:30:30))))
 (CELL (CELLTYPE "sh_reject") (INSTANCE hierarchy) (TIMINGCHECK (SETUP nested/D (posedge C) (30:30:30)) (HOLD nested/D (posedge C) (30:30:30))))
 (CELL (CELLTYPE "sh_reject") (INSTANCE valid) (TIMINGCHECK (SETUP D (posedge C) (30:30:30)) (HOLD D (posedge C) (30:30:30))))
 (CELL (CELLTYPE "sh_reject") (INSTANCE absent_instance) (TIMINGCHECK (SETUP D (posedge C) (50:50:50)) (HOLD D (posedge C) (50:50:50))))
 (CELL (CELLTYPE "sh_reject") (INSTANCE combined) (TIMINGCHECK (SETUPHOLD D (posedge C) (30:30:30) (30:30:30))))
)
