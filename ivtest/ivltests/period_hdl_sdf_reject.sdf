(DELAYFILE (SDFVERSION "3.0") (TIMESCALE 1ps)
  (CELL (CELLTYPE "period_reject_leaf") (INSTANCE conditional) (TIMINGCHECK (PERIOD (COND en (posedge CLK)) (20:20:20))))
  (CELL (CELLTYPE "period_reject_leaf") (INSTANCE malformed) (TIMINGCHECK (PERIOD (COND CLK) (20:20:20))))
  (CELL (CELLTYPE "period_reject_leaf") (INSTANCE wrong_edge) (TIMINGCHECK (PERIOD (negedge CLK) (20:20:20))))
  (CELL (CELLTYPE "period_reject_leaf") (INSTANCE wrong_ref) (TIMINGCHECK (PERIOD (posedge OTHER) (20:20:20))))
  (CELL (CELLTYPE "period_reject_leaf") (INSTANCE negative) (TIMINGCHECK (PERIOD (posedge CLK) (-1:-1:-1))))
  (CELL (CELLTYPE "period_reject_leaf") (INSTANCE negative_magnitude) (TIMINGCHECK (PERIOD (posedge CLK) (-4096:-4096:-4096))))
  (CELL (CELLTYPE "period_reject_leaf") (INSTANCE overflow) (TIMINGCHECK (PERIOD (posedge CLK) (1e30:1e30:1e30))))
  (CELL (CELLTYPE "wrong_type") (INSTANCE wrong_cell) (TIMINGCHECK (PERIOD (posedge CLK) (20:20:20))))
  (CELL (CELLTYPE "period_reject_leaf") (INSTANCE valid) (TIMINGCHECK (PERIOD (posedge CLK) (20:20:20))))
)
