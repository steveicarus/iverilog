   (COND E (IOPATH A Z (91) (93)))
   (COND E == 1'b1 (IOPATH A ZCASE (91) (93)))
   (COND V == 1'b1 (IOPATH A ZV (91) (93)))
   (COND E == 1'b1 (IOPATH A ZI (91) (93)))
   (COND E == 1'b1 (IOPATH A ZBARE (91) (93)))
