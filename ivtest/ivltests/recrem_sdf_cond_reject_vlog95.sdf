(DELAYFILE (SDFVERSION "3.0") (DIVIDER /) (TIMESCALE 1ps)
 (CELL (CELLTYPE "recrem_cond_reject[tb.u]") (INSTANCE u) (TIMINGCHECK
  (RECREM (COND E == 1'b1 (posedge R)) (COND F === 1'b0 (posedge C)) (99:99:99) (99:99:99))
  (RECREM (COND E != 1'b1 (posedge R)) (COND F === 1'b0 (posedge C)) (99:99:99) (99:99:99))
  (RECREM (COND !E (posedge R)) (COND F === 1'b0 (posedge C)) (99:99:99) (99:99:99))
  (RECREM (COND E[0] (posedge R)) (COND F === 1'b0 (posedge C)) (99:99:99) (99:99:99))
  (RECREM (COND sub/E (posedge R)) (COND F === 1'b0 (posedge C)) (99:99:99) (99:99:99))
  (RECREM (COND G (posedge R)) (COND F === 1'b0 (posedge C)) (99:99:99) (99:99:99))
  (RECREM (COND E === 1'b1 (posedge R)) (COND F === 1'b0 (posedge C)) (99:99:99) (99:99:99))
  (RECREM (COND E === 1'b0 (posedge R)) (COND F === 1'b0 (posedge C)) (99:99:99) (99:99:99))
  (RECREM (COND E (negedge R)) (COND F === 1'b0 (posedge C)) (99:99:99) (99:99:99))
  (RECREM (COND E (posedge R)) (COND F == 1'b1 (posedge C)) (99:99:99) (99:99:99))
  (RECREM (COND E (posedge R)) (COND F != 1'b1 (posedge C)) (99:99:99) (99:99:99))
  (RECREM (COND E (posedge R)) (COND !F (posedge C)) (99:99:99) (99:99:99))
  (RECREM (COND E (posedge R)) (COND F[0] (posedge C)) (99:99:99) (99:99:99))
  (RECREM (COND E (posedge R)) (COND sub/F (posedge C)) (99:99:99) (99:99:99))
  (RECREM (COND E (posedge R)) (COND G (posedge C)) (99:99:99) (99:99:99))
  (RECREM (COND E (posedge R)) (COND F (posedge C)) (99:99:99) (99:99:99))
  (RECREM (COND E (posedge R)) (COND F === 1'b1 (posedge C)) (99:99:99) (99:99:99))
  (RECREM (COND E (posedge R)) (COND F === 1'b0 (negedge C)) (99:99:99) (99:99:99))))
 (CELL (CELLTYPE "recrem_cond_reject[tb.neg_second]") (INSTANCE neg_second) (TIMINGCHECK (RECREM (COND E (posedge R)) (COND F === 1'b0 (posedge C)) (99:99:99) (-1:-1:-1))))
 (CELL (CELLTYPE "recrem_cond_reject[tb.neg_first]") (INSTANCE neg_first) (TIMINGCHECK (RECREM (COND E (posedge R)) (COND F === 1'b0 (posedge C)) (-1:-1:-1) (99:99:99))))
 (CELL (CELLTYPE "recrem_cond_reject[tb.u]") (INSTANCE u) (TIMINGCHECK (RECREM (COND E (posedge R)) (COND F === 1'b0 (posedge C)) (1.0e30) (-1))))
 (CELL (CELLTYPE "recrem_cond_reject[tb.u]") (INSTANCE u) (TIMINGCHECK (RECREM (COND E (posedge R)) (COND F === 1'b0 (posedge C)) (-1) (1.0e30))))
 (CELL (CELLTYPE "recrem_cond_reject[tb.valid]") (INSTANCE valid) (TIMINGCHECK
  (RECREM (COND E (posedge R)) (COND F === 1'b0 (posedge C)) (20:20:20) (8:8:8))))
)
