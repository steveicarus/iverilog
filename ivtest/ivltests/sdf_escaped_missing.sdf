(DELAYFILE
 (SDFVERSION "3.0") (DESIGN "top") (DIVIDER .) (TIMESCALE 1ps)
 (CELL (CELLTYPE "delay_cell") (INSTANCE a\.b)
  (DELAY (ABSOLUTE (IOPATH A Z (3) (5)))))
 (CELL (CELLTYPE "top") (INSTANCE)
  (DELAY (ABSOLUTE
   (INTERCONNECT d.Z missing\.sink.A (3) (5))
   (INTERCONNECT d.Z r.missing\.A[0] (3) (5))
   (INTERCONNECT d.Z r.A (7) (9)))))
)
