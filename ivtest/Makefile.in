SHELL = /bin/sh

abs_srcdir=@abs_srcdir@
srcdir=@srcdir@
CC = @CC@
CFLAGS = @CFLAGS@
CPPFLAGS = @CPPFLAGS@
LDFLAGS = @LDFLAGS@
suffix = @install_suffix@
ifeq (@install_suffix@,)
opts =
else
opts = --suffix=$(suffix)
endif

all:

check:

check-installed:
	@status=0; \
	$(MAKE) check-installed-vvp || status=1; \
	$(MAKE) check-installed-vvp-py || status=1; \
	$(MAKE) check-installed-tchk-vlog95 || status=1; \
	$(MAKE) check-installed-vpi || status=1; \
	$(MAKE) check-installed-fst || status=1; \
	exit $$status

check-installed-vpi:
	@echo "Running vpi_reg.pl"
ifeq (@LIBVERIUSER@,yes)
	cd $(abs_srcdir); perl vpi_reg.pl --with-pli1 $(opts)
else
	cd $(abs_srcdir); perl vpi_reg.pl $(opts)
endif

check-installed-vvp:
	@echo "Running vvp_reg.pl"
	cd $(abs_srcdir); perl vvp_reg.pl $(opts)

check-installed-vvp-py:
	@echo "Running vvp_reg.py"
	cd $(abs_srcdir); python3 vvp_reg.py $(opts)

# Exercise the emitted checks as well as their native VVP counterparts.
check-installed-tchk-vlog95:
	cd $(abs_srcdir); python3 vvp_reg.py $(opts) --vlog95 regress-tchk-notifier.list regress-tchk-target-corners.list

ifeq (@HAVE_LIBZ@,yes)
fst_enum_reader@EXEEXT@: $(srcdir)/fst_enum_reader.c ../vpi/fstapi.o ../vpi/fastlz.o ../vpi/lz4.o
	$(CC) $(CPPFLAGS) $(CFLAGS) -UNDEBUG -I$(srcdir)/../vpi $(LDFLAGS) -o $@ $^ @LIBS@

check-installed-fst: fst_enum_reader@EXEEXT@
	python3 $(srcdir)/fst_enum.py --reader=@abs_builddir@/fst_enum_reader@EXEEXT@ --suffix=$(suffix)
else
check-installed-fst:
	@echo "FST enum test skipped: configured without zlib/FST support"
endif

clean:
	rm -f $(srcdir)/*.vpi fst_enum_reader@EXEEXT@
	rm -rf $(srcdir)/log $(srcdir)/vpi_log $(srcdir)/work

distclean: clean
	rm -f Makefile

install:

uninstall:

Makefile: $(srcdir)/Makefile.in ../config.status
	cd ..; ./config.status --file=ivtest/$@

.PHONY: check-installed-fst check-installed check-installed-vpi check-installed-vvp check-installed-vvp-py

.PHONY: check-installed-tchk-vlog95
