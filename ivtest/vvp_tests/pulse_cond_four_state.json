      "expected": [
        ["width", "posedge", "!==", "0", "wcn0"],
        ["width", "posedge", "!==", "1", "wcn1"],
        ["period", "negedge", "!==", "0", "pcn0"],
        ["period", "negedge", "!==", "1", "pcn1"]
      ]
    }
  }
}
